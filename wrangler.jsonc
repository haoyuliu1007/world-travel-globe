{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "world-travel-globe",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}

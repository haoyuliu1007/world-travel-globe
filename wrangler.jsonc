{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "world-travel-globe",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "world-travel-globe-db",
      "database_id": "44a8e352-c04d-4009-a45a-dc5d3c5a6d5c",
      "migrations_dir": "migrations"
    }
  ]
}
